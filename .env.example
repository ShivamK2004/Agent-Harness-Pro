# Provider: mock | gemini | ollama
LLM_PROVIDER=mock

# Gemini (Google AI Studio)
GEMINI_API_KEY=your_api_key_here
GEMINI_MODEL=gemini-3.8-flash

# Ollama local model
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3:latest
OLLAMA_TIMEOUT_SECONDS=180

# App configuration
APP_NAME=Agent Harness Pro
APP_ENV=development
DATABASE_URL=sqlite:///data/agent_harness.db
WORKSPACE_DIR=workspace
KNOWLEDGE_BASE_DIR=knowledge_base
LOG_DIR=logs
BENCHMARK_DATASET=benchmarks/tasks.json
MAX_TOOL_OUTPUT_CHARS=8000
MAX_WORKSPACE_FILE_BYTES=200000
MAX_AGENT_STEPS=5
REQUEST_TIMEOUT_SECONDS=120

# Optional second model call for advisory verification (disabled by default for lower latency)
MODEL_VERIFIER_ENABLED=false
